# Group 4 Server Configuration
PORT=8000
HOST=0.0.0.0

# Student Resource Book Path (Default checks data/SRB_2026.pdf)
SRB_PDF_PATH=data/SRB_2026.pdf

# Group 9 new-course passages (CSV from Group 9 handoffs.group4_chunks); loaded at start-up if present
COURSE_PASSAGES_CSV=data/group9/group4_chunks.csv

# Group 9 Curriculum Intelligence Engine Endpoint
GROUP9_API_URL=http://localhost:8001
GROUP9_TIMEOUT=10.0

# Mandatory Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Retrieval Hyperparameters
RETRIEVAL_BETA=0.6
RERANK_ALPHA=0.7
CONFIDENCE_GATE=0.24
TOP_K_PASSAGES=2
