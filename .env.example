# Group 4 Server Configuration
PORT=8000
HOST=0.0.0.0

# Student Resource Book Path (Default checks data/SRB_2026.pdf)
SRB_PDF_PATH=data/SRB_2026.pdf

# Curriculum Intelligence runs inside this application ("local"). Set "remote" to prefer a running engine at GROUP9_API_URL.
CURRICULUM_BACKEND=local
GROUP9_API_URL=http://localhost:8001
GROUP9_TIMEOUT=10.0

# Mandatory Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=

# Retrieval Hyperparameters
QUERY_EXPANSION=true
RRF_K=60
RERANK_CANDIDATES=30
RERANK_WEIGHT=0.6
RERANK_WITH=both
VARIANT_WEIGHT=0.5
CONFIDENCE_GATE=0.10
TOP_K_PASSAGES=4
MAX_CHUNK_WORDS=130
TORCH_THREADS=4
